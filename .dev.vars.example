# Copy to .dev.vars for local `astro dev` / wrangler secrets.
# Magic-link works in stub mode when RESEND_API_KEY is unset (link logged in terminal).

# Required for /admin
ADMIN_SECRET=dev-admin-secret-change-me

# BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# SESSION_SECRET=legacy-fallback-for-BETTER_AUTH_SECRET
# RESEND_API_KEY=re_xxx
# PUBLIC_APP_URL=http://localhost:4321
# BETTER_AUTH_URL=http://localhost:4321

# LLM enrich — Workers AI is default when AI binding is present.
# OPENAI_API_KEY=sk-...
# GRANT_EXTRACTOR_PROVIDER=workers-ai|openai|auto
# DISCOVERY_LLM_ENRICH=1

# Stripe (later)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
