# Copy to .dev.vars for local `astro dev` / wrangler secrets.
# Magic-link works in stub mode when RESEND_API_KEY is unset (link logged in terminal).

# Required for /admin
ADMIN_SECRET=dev-admin-secret-change-me

# BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# SESSION_SECRET=legacy-fallback-for-BETTER_AUTH_SECRET
# RESEND_API_KEY=re_xxx
# PUBLIC_APP_URL=http://localhost:4321
# BETTER_AUTH_URL=http://localhost:4321

# LLM enrich — Workers AI is default when AI binding is present.
# OPENAI_API_KEY=sk-...
# GRANT_EXTRACTOR_PROVIDER=workers-ai|openai|auto
# DISCOVERY_LLM_ENRICH=1

# Paddle Billing (sandbox-first). Omit PADDLE_API_KEY to stub checkout + flip tier locally.
# PADDLE_ENV=sandbox
# PADDLE_API_KEY=pdl_sdbx_...
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# PADDLE_PRICE_SEEKER=pri_...
# PADDLE_PRICE_WRITER=pri_...
