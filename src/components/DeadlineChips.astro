---
import {
	formatIsoDateEnCa,
	isDeadlinePast,
	todayToronto,
	type GrantDeadline,
} from '@/lib/deadlines';

interface Props {
	deadlines: GrantDeadline[];
	notes?: string | null;
	rolling?: boolean;
	/** compact = list row; detail = larger chips */
	size?: 'sm' | 'md';
}

const { deadlines, notes, rolling = false, size = 'sm' } = Astro.props;
const today = todayToronto();
const pad = size === 'md' ? 'px-3 py-1.5 text-sm' : 'px-2 py-0.5 text-xs';
---

{
	rolling ? (
		<span
			class={`inline-flex items-center rounded-base border-2 border-border bg-main font-heading shadow-shadow ${pad}`}
		>
			Rolling
		</span>
	) : deadlines.length > 0 ? (
		<span class="flex flex-wrap gap-1.5">
			{deadlines.map((d) => {
				const past = isDeadlinePast(d.date, today);
				return (
					<span
						class:list={[
							'inline-flex items-center gap-1 rounded-base border-2 border-border',
							pad,
							past
								? 'bg-secondary-background/80 text-foreground/45 opacity-60 shadow-none line-through decoration-foreground/30'
								: 'bg-main/40 text-foreground shadow-shadow',
						]}
						title={past ? 'Past deadline' : undefined}
					>
						<span class="font-heading tabular-nums">{formatIsoDateEnCa(d.date)}</span>
						{d.label && (
							<span class={past ? 'text-foreground/40' : 'text-foreground/70'}>· {d.label}</span>
						)}
					</span>
				);
			})}
		</span>
	) : notes ? (
		<span class={`text-foreground/80 ${size === 'md' ? 'text-base' : 'text-sm'}`}>{notes}</span>
	) : (
		<span class={`text-foreground/60 ${size === 'md' ? 'text-base' : 'text-sm'}`}>See funder site</span>
	)
}
