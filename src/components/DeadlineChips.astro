---
import {
	formatIsoDateEnCa,
	type GrantDeadline,
} from '@/lib/deadlines';

interface Props {
	deadlines: GrantDeadline[];
	notes?: string | null;
	rolling?: boolean;
	/** compact = list row; detail = larger chips */
	size?: 'sm' | 'md';
}

const { deadlines, notes, rolling = false, size = 'sm' } = Astro.props;
const pad = size === 'md' ? 'px-3 py-1.5 text-sm' : 'px-2 py-0.5 text-xs';
---

{
	rolling ? (
		<span
			class={`inline-flex items-center rounded-base border-2 border-border bg-main font-heading shadow-shadow ${pad}`}
		>
			Rolling
		</span>
	) : deadlines.length > 0 ? (
		<span class="flex flex-wrap gap-1.5">
			{deadlines.map((d) => (
				<span
					class={`inline-flex items-center gap-1 rounded-base border-2 border-border bg-main/40 shadow-shadow ${pad}`}
				>
					<span class="font-heading tabular-nums">{formatIsoDateEnCa(d.date)}</span>
					{d.label && <span class="text-foreground/70">· {d.label}</span>}
				</span>
			))}
		</span>
	) : notes ? (
		<span class={`text-foreground/80 ${size === 'md' ? 'text-base' : 'text-sm'}`}>{notes}</span>
	) : (
		<span class={`text-foreground/60 ${size === 'md' ? 'text-base' : 'text-sm'}`}>See funder site</span>
	)
}
