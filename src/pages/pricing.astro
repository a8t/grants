---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { FREE_SAVE_CAP, isListedWriter, isPaidSeeker } from '@/lib/billing';
import { cn } from '@/lib/utils';

const user = Astro.locals.user;
const error = Astro.url.searchParams.get('error');
const paidSeeker = isPaidSeeker(user);
const listedWriter = isListedWriter(user);
const signedIn = Boolean(user);
---

<BaseLayout title="Pricing — Grant Finder" description="Seeker paid plan and writer listing via Paddle.">
	<section class="mx-auto max-w-5xl px-4 pb-16 pt-10">
		<div class="max-w-2xl">
			<h1 class="text-4xl sm:text-5xl">Simple pricing</h1>
			<p class="mt-3 text-foreground/80">
				Guest browse is free. Seekers upgrade for saves + reminders. Writers pay to list in Connect.
				Billing via <span class="font-heading">Paddle</span> (Merchant of Record — sandbox-first).
			</p>
		</div>

		{
			error && (
				<p class="mt-6 rounded-base border-2 border-border bg-[#ff4d50]/80 px-4 py-3 text-sm shadow-shadow">
					{error}
				</p>
			)
		}

		{
			user && (
				<p class="mt-6 rounded-base border-2 border-border bg-main/30 px-4 py-3 text-sm shadow-shadow">
					Signed in as <span class="font-heading">{user.email}</span>
					{' · '}
					{user.accountType === 'writer' ? 'writer' : 'seeker'}
					{' · '}
					tier <Badge className="ml-1">{user.subscriptionTier || 'free'}</Badge>
					{user.subscriptionStatus ? ` · ${user.subscriptionStatus}` : ''}
				</p>
			)
		}

		<div class="mt-10 grid gap-6 md:grid-cols-2">
			<article class="rounded-base border-2 border-border bg-secondary-background p-6 shadow-shadow">
				<p class="text-sm text-foreground/70">Seekers</p>
				<h2 class="mt-1 text-3xl">Paid seeker</h2>
				<p class="mt-3 text-foreground/85">
					Unlimited saves, ranked matches, deadline calendar + email reminders (coming online next).
					Free accounts keep sticky filters and a {FREE_SAVE_CAP}-save cap.
				</p>
				<ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-foreground/85">
					<li>Guest browse stays free</li>
					<li>Free: sticky profile + limited saves</li>
					<li>Paid: full match + reminders</li>
				</ul>
				<div class="mt-8">
					{
						paidSeeker ? (
							<span class={cn(buttonVariants({ size: 'lg', variant: 'neutral' }), 'opacity-80')}>
								You’re on paid
							</span>
						) : signedIn ? (
							<form method="post" action="/api/paddle/checkout">
								<input type="hidden" name="kind" value="seeker_paid" />
								<button type="submit" class={cn(buttonVariants({ size: 'lg' }))}>
									Upgrade with Paddle
								</button>
							</form>
						) : (
							<a href="/sign-in?next=/pricing" class={cn(buttonVariants({ size: 'lg' }), 'no-underline')}>
								Sign in to upgrade
							</a>
						)
					}
				</div>
			</article>

			<article class="rounded-base border-2 border-border bg-secondary-background p-6 shadow-shadow">
				<p class="text-sm text-foreground/70">Grant writers</p>
				<h2 class="mt-1 text-3xl">Listed writer</h2>
				<p class="mt-3 text-foreground/85">
					Pay to appear in Connect. Seekers discover you and send lead requests (email alerts).
				</p>
				<ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-foreground/85">
					<li>Public profile in Connect directory</li>
					<li>Lead notifications by email</li>
					<li>Cancel anytime via Paddle</li>
				</ul>
				<div class="mt-8">
					{
						listedWriter ? (
							<span class={cn(buttonVariants({ size: 'lg', variant: 'neutral' }), 'opacity-80')}>
								You’re listed
							</span>
						) : signedIn ? (
							<form method="post" action="/api/paddle/checkout">
								<input type="hidden" name="kind" value="writer_paid" />
								<button type="submit" class={cn(buttonVariants({ size: 'lg' }))}>
									List me — pay with Paddle
								</button>
							</form>
						) : (
							<a href="/sign-in?next=/pricing" class={cn(buttonVariants({ size: 'lg' }), 'no-underline')}>
								Sign in to list
							</a>
						)
					}
				</div>
			</article>
		</div>

		<p class="mt-10 text-sm text-foreground/70">
			Without <code class="rounded-base border-2 border-border px-1">PADDLE_API_KEY</code>, checkout stubs
			and flips your tier locally for demos. Real sandbox: set keys + price IDs (see README).
		</p>
	</section>
</BaseLayout>
