---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { getDb, parseJsonArray } from '@/lib/db';
import { listListedWriters } from '@/lib/writers';
import { cn } from '@/lib/utils';

const user = Astro.locals.user;
const leadFlash = Astro.url.searchParams.get('lead');
const errorCode = Astro.url.searchParams.get('error');

let writers = [];
let error: string | null = null;
try {
	const db = getDb();
	writers = await listListedWriters(db);
} catch (e) {
	error = e instanceof Error ? e.message : 'Could not load writers.';
}
---

<BaseLayout title="Connect — grant writers — Grant Finder">
	<section class="mx-auto max-w-6xl px-4 pb-16 pt-8">
		<div class="mb-8 max-w-2xl">
			<h1 class="text-4xl sm:text-5xl">Connect</h1>
			<p class="mt-3 text-foreground/80">
				Directory of grant writers who work with Ontario arts &amp; culture applicants. Only paid /
				listed writers appear and can receive lead requests.
			</p>
		</div>

		{
			leadFlash === 'sent' && (
				<p class="mb-6 rounded-base border-2 border-border bg-main/40 px-4 py-3 text-sm shadow-shadow">
					Intro request sent. The writer gets an email (Resend / stub).
				</p>
			)
		}
		{
			errorCode === 'WRITER_NOT_LISTED' && (
				<p class="mb-6 rounded-base border-2 border-border bg-[#ff4d50]/80 px-4 py-3 text-sm shadow-shadow">
					That writer is not listed — leads are blocked.
				</p>
			)
		}
		{
			errorCode === 'AUTH_REQUIRED' && (
				<p class="mb-6 rounded-base border-2 border-border bg-[#ff4d50]/80 px-4 py-3 text-sm shadow-shadow">
					Sign in as a seeker to request an intro.
				</p>
			)
		}

		{
			error ? (
				<div class="rounded-base border-2 border-border bg-[#ff4d50] p-4 shadow-shadow">
					<p class="font-heading">Database not ready</p>
					<p class="mt-1 text-sm">{error}</p>
				</div>
			) : (
				<ul class="grid gap-4 sm:grid-cols-2">
					{writers.map((writer) => {
						const disciplines = parseJsonArray(writer.disciplines);
						const provinces = parseJsonArray(writer.provinces);
						return (
							<li class="flex flex-col rounded-base border-2 border-border bg-secondary-background p-5 shadow-shadow">
								<div class="flex flex-wrap items-start justify-between gap-2">
									<div>
										<h2 class="text-2xl">{writer.display_name}</h2>
										{writer.org_name && (
											<p class="text-sm text-foreground/70">{writer.org_name}</p>
										)}
									</div>
									<Badge>Listed</Badge>
								</div>
								<p class="mt-3 flex-1 text-sm leading-relaxed text-foreground/85">{writer.bio}</p>
								<div class="mt-4 flex flex-wrap gap-1.5">
									{disciplines.map((d) => (
										<span class="rounded-base border-2 border-border bg-main/40 px-2 py-0.5 text-xs">
											{d}
										</span>
									))}
								</div>
								<div class="mt-4 text-sm">
									<span class="font-heading">Area</span> {provinces.join(', ')}
									{writer.rate_range ? ` · ${writer.rate_range}` : ''}
								</div>
								{
									user ? (
										<form method="POST" action="/api/leads" class="mt-4 space-y-2">
											<input type="hidden" name="writerUserId" value={writer.user_id} />
											<label class="block text-xs font-heading">Message</label>
											<textarea
												name="message"
												required
												rows="3"
												maxlength="2000"
												class="w-full rounded-base border-2 border-border bg-secondary-background p-2 text-sm shadow-shadow"
												placeholder="Brief intro request…"
											/>
											<button type="submit" class={cn(buttonVariants({ size: 'sm' }))}>
												Request intro
											</button>
										</form>
									) : (
										<a
											href="/sign-in?next=/connect"
											class={cn(buttonVariants({ size: 'sm', variant: 'neutral' }), 'mt-4 inline-flex no-underline')}
										>
											Sign in to request intro
										</a>
									)
								}
							</li>
						);
					})}
				</ul>
			)
		}

		{
			!error && writers.length === 0 && (
				<div class="rounded-base border-2 border-border bg-secondary-background p-8 text-center shadow-shadow">
					<p class="font-heading text-xl">No listed writers yet</p>
					<p class="mt-2 text-sm">Seed the database or pay to list via Paddle.</p>
				</div>
			)
		}
	</section>
</BaseLayout>
