---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { isAdminAuthed } from '@/lib/admin';
import { getDb, getEnv } from '@/lib/db';
import type { GrantExtract } from '@/lib/discovery/extract';
import { cn } from '@/lib/utils';

const env = getEnv();
if (!isAdminAuthed(Astro.request, env)) {
	return Astro.redirect('/admin/login');
}

const status = Astro.url.searchParams.get('status') || 'pending';
const db = getDb();
const rows = await db
	.prepare(
		`SELECT p.*, s.name AS source_name
     FROM grant_proposals p
     JOIN grant_sources s ON s.id = p.source_id
     WHERE p.status = ?
     ORDER BY p.discovered_at DESC
     LIMIT 80`,
	)
	.bind(status)
	.all<{
		id: string;
		title: string;
		funder: string;
		url: string;
		deadline_at: string | null;
		deadline_notes: string | null;
		raw_excerpt: string | null;
		applicant_types: string;
		amount_notes: string | null;
		province_scope: string;
		status: string;
		source_name: string;
		discovered_at: string;
		llm_extract_json: string | null;
		llm_provider: string | null;
		llm_model: string | null;
		llm_enriched_at: string | null;
		llm_error: string | null;
	}>();

function parseExtract(raw: string | null): GrantExtract | null {
	if (!raw) return null;
	try {
		return JSON.parse(raw) as GrantExtract;
	} catch {
		return null;
	}
}

const flash =
	Astro.url.searchParams.get('enriched') != null
		? `Bulk enrich: ${Astro.url.searchParams.get('enriched')} ok, ${Astro.url.searchParams.get('failed') ?? 0} failed`
		: Astro.url.searchParams.get('enrich') === '1'
			? 'LLM enrich saved on proposal (not published).'
			: Astro.url.searchParams.get('enrich') === '0'
				? 'LLM enrich failed — see proposal error.'
				: null;
---

<AdminLayout title="Review queue — Admin">
	<div class="flex flex-wrap items-end justify-between gap-4">
		<div>
			<h1 class="text-4xl">Review queue</h1>
			<p class="mt-2 text-foreground/80">
				Scrape vs LLM side-by-side. Enrich never auto-publishes — Approve still required.
			</p>
		</div>
		<div class="flex flex-wrap gap-2">
			{
				(['pending', 'approved', 'rejected'] as const).map((s) => (
					<a
						href={`/admin/proposals?status=${s}`}
						class={cn(
							buttonVariants({ variant: status === s ? 'default' : 'neutral', size: 'sm' }),
							'no-underline',
						)}
					>
						{s}
					</a>
				))
			}
			{
				status === 'pending' && (
					<form method="post" action="/admin/api/enrich">
						<input type="hidden" name="bulk" value="1" />
						<button type="submit" class={cn(buttonVariants({ size: 'sm' }))}>
							Bulk enrich pending
						</button>
					</form>
				)
			}
		</div>
	</div>

	{flash && (
		<p class="mt-4 rounded-base border-2 border-border bg-main/40 px-4 py-2 text-sm">{flash}</p>
	)}

	<ul class="mt-8 grid gap-4">
		{
			(rows.results ?? []).map((p) => {
				const llm = parseExtract(p.llm_extract_json);
				const formTitle = llm?.title || p.title;
				const formFunder = llm?.funder || p.funder;
				const formDeadline = llm?.deadline_at ?? p.deadline_at ?? '';
				const formDeadlineNotes = llm?.deadline_notes ?? p.deadline_notes ?? '';
				const formElig = llm?.eligibility_summary || p.raw_excerpt || '';
				const formApplicants = llm?.applicant_types || p.applicant_types;
				const formAmount =
					llm?.amount_notes ||
					(llm?.amount_min != null || llm?.amount_max != null
						? [llm.amount_min, llm.amount_max].filter((x) => x != null).join(' – ')
						: p.amount_notes) ||
					'';
				return (
					<li class="rounded-base border-2 border-border bg-secondary-background p-5 shadow-shadow">
						<div class="flex flex-wrap items-start justify-between gap-2">
							<div>
								<p class="text-sm text-foreground/70">
									{p.source_name} · {p.funder}
								</p>
								<h2 class="text-2xl leading-tight">{p.title}</h2>
							</div>
							<div class="flex flex-wrap gap-2">
								<Badge variant="neutral">{p.status}</Badge>
								{llm && (
									<Badge>
										LLM {Math.round((llm.confidence ?? 0) * 100)}%
										{p.llm_provider ? ` · ${p.llm_provider}` : ''}
									</Badge>
								)}
							</div>
						</div>
						<p class="mt-2 text-sm">
							<a href={p.url} class="underline break-all" target="_blank" rel="noopener noreferrer">
								{p.url}
							</a>
						</p>

						<div class="mt-4 grid gap-3 md:grid-cols-2">
							<div class="rounded-base border-2 border-border bg-background/70 p-3 text-sm">
								<p class="font-heading text-xs uppercase tracking-wide">Scraped / list</p>
								<p class="mt-2">
									<span class="font-heading">Deadline</span>{' '}
									{p.deadline_at ?? p.deadline_notes ?? '—'}
								</p>
								<p>
									<span class="font-heading">Who</span> {p.applicant_types} · {p.province_scope}
								</p>
								<p class="mt-2 text-foreground/85">{p.raw_excerpt ?? '—'}</p>
							</div>
							<div class="rounded-base border-2 border-border bg-main/25 p-3 text-sm">
								<p class="font-heading text-xs uppercase tracking-wide">LLM extract</p>
								{p.llm_error && <p class="mt-2 text-[#b00020]">{p.llm_error}</p>}
								{!llm && !p.llm_error && <p class="mt-2 text-foreground/70">Not enriched yet.</p>}
								{llm && (
									<>
										<p class="mt-2">
											<span class="font-heading">Deadline</span>{' '}
											{llm.deadline_at ?? llm.deadline_notes ?? '—'}
										</p>
										<p>
											<span class="font-heading">Amount</span>{' '}
											{llm.amount_notes ||
												(llm.amount_min != null || llm.amount_max != null
													? `${llm.amount_min ?? '?'} – ${llm.amount_max ?? '?'}`
													: '—')}
										</p>
										<p>
											<span class="font-heading">Who</span> {llm.applicant_types ?? '—'} ·{' '}
											{llm.province_scope ?? '—'}
										</p>
										<p class="mt-2">{llm.eligibility_summary ?? '—'}</p>
										{llm.quotes?.length > 0 && (
											<ul class="mt-2 list-disc pl-4 text-xs text-foreground/80">
												{llm.quotes.slice(0, 3).map((q) => (
													<li>“{q}”</li>
												))}
											</ul>
										)}
										{p.llm_enriched_at && (
											<p class="mt-2 text-xs text-foreground/60">
												{p.llm_model} · {p.llm_enriched_at}
											</p>
										)}
									</>
								)}
							</div>
						</div>

						{p.status === 'pending' && (
							<div class="mt-4 flex flex-wrap gap-2">
								<form method="post" action="/admin/api/enrich">
									<input type="hidden" name="id" value={p.id} />
									<button type="submit" class={cn(buttonVariants({ variant: 'neutral', size: 'sm' }))}>
										Enrich with LLM
									</button>
								</form>
							</div>
						)}

						{p.status === 'pending' && (
							<form method="post" action="/admin/api/review" class="mt-5 grid gap-3 border-t-2 border-border pt-4">
								<input type="hidden" name="id" value={p.id} />
								<p class="text-xs text-foreground/70">
									Form prefilled from LLM when confidence looks usable — edit before Approve.
								</p>
								<label class="grid gap-1 text-sm">
									<span class="font-heading">Title</span>
									<input name="title" value={formTitle} class="h-10 rounded-base border-2 border-border px-3" />
								</label>
								<label class="grid gap-1 text-sm">
									<span class="font-heading">Funder</span>
									<input name="funder" value={formFunder} class="h-10 rounded-base border-2 border-border px-3" />
								</label>
								<label class="grid gap-1 text-sm">
									<span class="font-heading">Eligibility / excerpt</span>
									<textarea name="eligibility_summary" rows="3" class="rounded-base border-2 border-border px-3 py-2">{formElig}</textarea>
								</label>
								<div class="grid gap-3 sm:grid-cols-3">
									<label class="grid gap-1 text-sm">
										<span class="font-heading">Deadline (YYYY-MM-DD)</span>
										<input name="deadline_at" value={formDeadline} class="h-10 rounded-base border-2 border-border px-3" />
									</label>
									<label class="grid gap-1 text-sm">
										<span class="font-heading">Deadline notes</span>
										<input name="deadline_notes" value={formDeadlineNotes} class="h-10 rounded-base border-2 border-border px-3" />
									</label>
									<label class="grid gap-1 text-sm">
										<span class="font-heading">Applicant types</span>
										<select name="applicant_types" class="h-10 rounded-base border-2 border-border px-3">
											<option value="both" selected={formApplicants === 'both'}>both</option>
											<option value="individual" selected={formApplicants === 'individual'}>individual</option>
											<option value="organization" selected={formApplicants === 'organization'}>organization</option>
										</select>
									</label>
								</div>
								<label class="grid gap-1 text-sm">
									<span class="font-heading">Amount notes</span>
									<input name="amount_notes" value={formAmount} class="h-10 rounded-base border-2 border-border px-3" />
								</label>
								<div class="flex flex-wrap gap-2">
									<button type="submit" name="action" value="approve" class={cn(buttonVariants())}>
										Approve → publish
									</button>
									<button type="submit" name="action" value="reject" class={cn(buttonVariants({ variant: 'neutral' }))}>
										Reject
									</button>
								</div>
							</form>
						)}
					</li>
				);
			})
		}
	</ul>

	{(rows.results ?? []).length === 0 && (
		<p class="mt-8 rounded-base border-2 border-border bg-secondary-background p-6 shadow-shadow">
			No {status} proposals. Run discovery from Sources.
		</p>
	)}
</AdminLayout>
