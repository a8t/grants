---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DeadlineChips from '@/components/DeadlineChips.astro';
import { buttonVariants } from '@/components/ui/button';
import { isPaidSeeker } from '@/lib/billing';
import { getDb } from '@/lib/db';
import { grantDeadlines } from '@/lib/grants';
import { getCalendarSaves } from '@/lib/saves';
import type { Grant } from '@/lib/types';
import { cn } from '@/lib/utils';

const user = Astro.locals.user;
const paid = isPaidSeeker(user);

let items: Awaited<ReturnType<typeof getCalendarSaves>> = [];
let gate: 'guest' | 'free' | 'ok' = 'guest';
if (!user) {
	gate = 'guest';
} else if (!paid) {
	gate = 'free';
} else {
	gate = 'ok';
	try {
		items = await getCalendarSaves(getDb(), user);
	} catch {
		items = [];
	}
}
---

<BaseLayout title="Deadline calendar — Grant Finder">
	<section class="mx-auto max-w-3xl px-4 pb-16 pt-8">
		<h1 class="text-4xl sm:text-5xl">Deadline calendar</h1>
		<p class="mt-3 text-foreground/80">
			Saved grants with structured deadlines. Paid seekers only — pair with email reminders.
		</p>

		{
			gate === 'guest' && (
				<div class="mt-8 rounded-base border-2 border-border bg-secondary-background p-6 shadow-shadow">
					<p class="font-heading text-xl">Sign in required</p>
					<a href="/sign-in?next=/calendar" class={cn(buttonVariants({ size: 'lg' }), 'mt-4 inline-flex no-underline')}>
						Sign in
					</a>
				</div>
			)
		}
		{
			gate === 'free' && (
				<div class="mt-8 rounded-base border-2 border-border bg-secondary-background p-6 shadow-shadow">
					<p class="font-heading text-xl">Upgrade for calendar</p>
					<p class="mt-2 text-sm text-foreground/80">
						Free accounts can save a limited set of grants. Unlock the deadline calendar and email
						reminders on paid.
					</p>
					<a href="/pricing" class={cn(buttonVariants({ size: 'lg' }), 'mt-4 inline-flex no-underline')}>
						Upgrade with Paddle
					</a>
				</div>
			)
		}
		{
			gate === 'ok' && (
				<ul class="mt-8 space-y-4">
					{items.length === 0 ? (
						<li class="rounded-base border-2 border-border bg-secondary-background p-6 shadow-shadow">
							<p class="font-heading">No saved grants yet</p>
							<a href="/grants" class={cn(buttonVariants({ size: 'sm' }), 'mt-3 inline-flex no-underline')}>
								Browse grants
							</a>
						</li>
					) : (
						items.map((row) => {
							const grantLike = {
								deadline_at: row.deadlineAt,
								deadline_notes: row.deadlineNotes,
								deadlines_json: row.deadlinesJson,
								status: row.status,
							} as Grant;
							return (
								<li class="rounded-base border-2 border-border bg-secondary-background p-5 shadow-shadow">
									<a href={`/grants/${row.slug}`} class="font-heading text-xl no-underline hover:underline">
										{row.name}
									</a>
									<p class="mt-1 text-sm text-foreground/70">{row.funder}</p>
									<div class="mt-3">
										<DeadlineChips
											deadlines={grantDeadlines(grantLike)}
											notes={row.deadlineNotes}
											rolling={row.status === 'rolling'}
											size="sm"
										/>
									</div>
								</li>
							);
						})
					)}
				</ul>
			)
		}

		{
			gate === 'ok' && (
				<p class="mt-8 text-sm">
					<a href="/account/reminders" class="font-heading underline">
						Configure email reminder offsets
					</a>
				</p>
			)
		}
	</section>
</BaseLayout>
