{
  "name": "canada-grant-finder",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply grants --local",
    "db:seed:local": "wrangler d1 execute grants --local --file=./scripts/seed.sql",
    "db:reset:local": "npm run db:migrate:local && npm run db:seed:local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/react": "^7.1.1",
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^0.544.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.152.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
